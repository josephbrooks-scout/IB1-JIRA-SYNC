{
  "name": "ib1-jira-tickets",
  "private": true,
  "version": "0.0.0",
  "description": "Turns IB1 commissioning specifications (XML) into Jira tickets (ECU, block/step) and keeps them in sync across IB1 versions. Includes a secondary page for comparing two IB1 versions.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josephbrooks-scout/IB1-JIRA-SYNC.git"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "serve": "vite preview --host 0.0.0.0",
    "preview": "vite preview",
    "test": "vitest run",
    "jira:plan": "node scripts/ib1-jira-plan.ts",
    "jira:sync": "node scripts/ib1-jira-sync.ts",
    "jira:local": "node scripts/ib1-jira-local.ts"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@xmldom/xmldom": "^0.9.12",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^5.0.5"
  }
}
