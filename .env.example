# Copy to .env (never commit .env). Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=service-account@example.com
JIRA_API_TOKEN=
JIRA_PROJECT=PRDFSI
# Issue type used for step/block tickets under the ECU ticket
JIRA_CHILD_ISSUE_TYPE=Commissioning Step
# Workflow status names the sync moves tickets to (matched case-insensitively)
JIRA_REOPEN_STATUS=Open
JIRA_REMOVED_STATUS=Not Relevant
